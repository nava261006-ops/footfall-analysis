# Target backend URL for Vite proxy during development
# Node.js Express backend default: http://localhost:3000
# Python FastAPI backend alternative: http://localhost:8000
VITE_API_URL="http://localhost:3000"

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# e.g.: 1234567890-abcdefg123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
